# --- Hebreeuws bronmateriaal ---
# De woordenlijsten (docx/pdf, samen een halve MB) gaan wel mee, zodat
# gereedschap/bouw_hebreeuws.py overal opnieuw te draaien is. De getagde bijbel is 42 MB
# en hoort net als de NT-tekst niet in de repo; wat we eruit halen staat in de JSON.
hebreeuws app/Hele bijbel.xlsx

# Werkbestanden van Claude Code; die horen bij deze machine, niet bij het project.
.claude/

# Reservekopieën van de voortgang: die horen niet in git — het is voortgang van studenten.
backups/

# Sleutels klaargezet om te kopiëren naar Render en Streamlit Cloud. Weggooien na gebruik.
sleutel_klaar/

# De NT-tekst staat nu per boek ingepakt in nt/ (2,9 MB in plaats van 31,5). Deze twee
# blijven lokaal staan als bron voor gereedschap/bouw_nt.py, maar horen niet in git.
bijbel_nt.json
bijbel_nt_deel1.json
bijbel_nt_deel2.json

# Werkbestanden bij het overtypen van de grammatica-slides. De plaatjes zijn een tussenstap
# (te maken met gereedschap/slides_beelden.py) en de proefpagina is om na te kijken; wat
# blijft is slides_werk/*.json en het samengevoegde grammatica_slides.json.
slides_werk/beelden/
slides_werk/proef.html

# De grammatica-slides staan overgetypt in grammatica_slides.json (624 kB). De pdf van
# 22 MB is daarmee bron geworden in plaats van bagage en staat niet meer in de repo. Terug
# te halen uit de geschiedenis als je een slide wilt nakijken:
#     git show 2af3a4a:grammatica_overzicht.pdf > grammatica_overzicht.pdf
grammatica_overzicht.pdf
